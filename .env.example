# Copy to .env next to compose.example.yaml and fill in. Keep .env out of git.
# Pin the Claude Code version; update deliberately by changing it and rebuilding.
CLAUDE_CODE_VERSION=
# The container user's ids; match the owner of the host directories below.
AGENT_UID=1000
AGENT_GID=1000
# Host paths. Include RELAYER_CLAUDE_DIR, RELAYER_WORK_DIR and RELAYER_STATE_DIR
# in your backups.
RELAYER_CLAUDE_DIR=
RELAYER_WORK_DIR=
RELAYER_STATE_DIR=
RELAYER_CONFIG_DIR=
RELAYER_MEM_LIMIT=4g
