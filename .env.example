# Copy to .env next to your compose file and fill in. Keep .env out of git.
# Pin an exact release tag; update deliberately by changing it.
RELAYER_IMAGE_TAG=
# Host paths. The definitions repository is mounted read-only. Back up the
# Claude, work and state directories. The published image runs as uid/gid
# 1000; give the writable directories to that user, or build your own image
# with --build-arg AGENT_UID=... --build-arg AGENT_GID=....
RELAYER_DEFINITIONS_DIR=
RELAYER_CONFIG_DIR=
RELAYER_CLAUDE_DIR=
RELAYER_WORK_DIR=
RELAYER_STATE_DIR=
RELAYER_MEM_LIMIT=4g
