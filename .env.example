# Copy to .env next to your compose file and fill in. Keep .env out of git.
# Pin an exact release tag; update deliberately by changing it.
RELAYER_IMAGE_TAG=
# Host paths. The definitions repository is mounted read-only. Back up the
# homes, work and state directories. Create them owned by root, mode 755
# (state: 700); the supervisor gives each heteronym its own subfolders.
RELAYER_DEFINITIONS_DIR=
RELAYER_CONFIG_DIR=
RELAYER_HOMES_DIR=
RELAYER_WORK_DIR=
RELAYER_STATE_DIR=
RELAYER_MEM_LIMIT=4g
